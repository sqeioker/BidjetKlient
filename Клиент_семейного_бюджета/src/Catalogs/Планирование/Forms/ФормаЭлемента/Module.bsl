

// Сохраняет двоичные данные изображения из временного хранилища
// в реквизит "ДанныеСообщения" объекта и удаляет их из хранилища.
//
// Параметры:
//  Адрес - Строка - адрес во временном хранилище, по которому находятся данные изображения.
//  Расширение - Строка - расширение файла изображения (не используется).
&НаСервере
Процедура УстановитьИзображение(Адрес, Расширение)
	
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	СпрОбъект = РеквизитФормыВЗначение("Объект");
	СпрОбъект.ДанныеСообщения = Новый ХранилищеЗначения(Данные, Новый СжатиеДанных(9));
	СпрОбъект.Записать();
	ЗначениеВРеквизитФормы(СпрОбъект, "Объект");
	УдалитьИзВременногоХранилища(Адрес);
	
КонецПроцедуры

// Отображает сохранённое изображение сообщения в элементе формы "Картинка".
&НаКлиенте
Процедура ПоказатьИзображение()
	
	Картинка = ПолучитьНавигационнуюСсылку(Объект.Ссылка, "ДанныеСообщения");
	Элементы.Картинка.Обновить();
	
КонецПроцедуры

// Обработчик нажатия на изображение.
//
// На мобильном клиенте делает фотоснимок и сохраняет его в объект,
// в остальных клиентах открывает диалог выбора файла для загрузки изображения.
//
// Параметры:
//  Элемент - ПолеКартинки - элемент формы, вызвавший обработчик.
//  СтандартнаяОбработка - Булево - стандартная обработка нажатия.
&НаКлиенте
Процедура КартинкаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	#Если МобильноеПриложениеКлиент Тогда
		Если СредстваМультимедиа.ПоддерживаетсяФотоснимок() Тогда
			Фотоснимок = СредстваМультимедиа.СделатьФотоснимок( , , 90);
			Если Фотоснимок <> Неопределено Тогда
				Адрес = ПоместитьВоВременноеХранилище(Фотоснимок.ПолучитьДвоичныеДанные());
				УстановитьИзображение(Адрес, Фотоснимок.РасширениеФайла);
				ПоказатьИзображение();
			КонецЕсли; 
		Иначе
			Предупреждение("Фотоснимок не поддерживается!");
		КонецЕсли;
	#Иначе
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.Заголовок = "Выберите файл";
		Диалог.ПолноеИмяФайла = ""; 
		Диалог.МножественныйВыбор = Ложь; 
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗагрузкиФайла",ЭтаФорма); 
		Диалог.Показать(ОписаниеОповещения);
		
	#КонецЕсли
	
КонецПроцедуры  

// На мобильном клиенте выполняет видеозапись средствами мультимедиа
// и помещает полученные двоичные данные во временное хранилище.
Процедура Видеозапись()
	
	#Если МобильноеПриложениеКлиент Тогда
		Если СредстваМультимедиа.ПоддерживаетсяВидеозапись() Тогда
			Видеозапись = СредстваМультимедиа.СделатьВидеозапись(, КачествоВидеозаписи.Высокое);
			Если Видеозапись <> Неопределено Тогда
				ДД = Видеозапись.ПолучитьДвоичныеДанные();
				Адрес = ПоместитьВоВременноеХранилище(ДД);
			КонецЕсли; 
		Иначе
			Предупреждение("Видеозапись не поддерживается!");
		КонецЕсли;	
	#КонецЕсли
	
КонецПроцедуры
	
// Обработчик оповещения после закрытия диалога выбора файла.
//
// Начинает помещение выбранного файла во временное хранилище.
//
// Параметры:
//  ВыбранныйФайл - Массив из Файл - выбранные в диалоге файлы.
//  ДопПараметр - Произвольный - дополнительные параметры оповещения.
&НаКлиенте
Процедура ПослеЗагрузкиФайла(ВыбранныйФайл,ДопПараметр) Экспорт
	
	Если ВыбранныйФайл = Неопределено Тогда 
		Возврат; 
	КонецЕсли; 
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтаФорма); 
	НачатьПомещениеФайла(ОписаниеОповещения,, ВыбранныйФайл[0], Ложь, УникальныйИдентификатор);  
	
КонецПроцедуры

// Обработчик оповещения после помещения файла во временное хранилище.
//
// Передаёт адрес файла на сервер для сохранения в объекте.
//
// Параметры:
//  Результат - Булево - Истина, если файл помещён успешно.
//  Адрес - Строка - адрес файла во временном хранилище.
//  ВыбранноеИмяФайла - Строка - имя выбранного файла.
//  ДопПараметры - Произвольный - дополнительные параметры оповещения.
&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла,ДопПараметры) Экспорт
	
	Если Не Результат Тогда 
		Возврат; 
	КонецЕсли; 
	СсылкаНаКартинку = Адрес;
	ПослеПомещенияФайлНаСервере(СсылкаНаКартинку);
	
КонецПроцедуры

// Сохраняет загруженное изображение из временного хранилища
// в реквизит "ДанныеСообщения" объекта и отображает его в форме.
//
// Параметры:
//  СсылкаНаКартинку - Строка - адрес изображения во временном хранилище.
&НаСервере
Процедура ПослеПомещенияФайлНаСервере(СсылкаНаКартинку)
	
	Если ЭтоАдресВременногоХранилища(СсылкаНаКартинку)  Тогда
		СпрОбъект = РеквизитФормыВЗначение("Объект");
		ФайлКартинки = ПолучитьИзВременногоХранилища(СсылкаНаКартинку); 
		СпрОбъект.ДанныеСообщения = Новый ХранилищеЗначения(ФайлКартинки); 
		СпрОбъект.Записать();
		ЗначениеВРеквизитФормы(СпрОбъект, "Объект");
		УдалитьИзВременногоХранилища(СсылкаНаКартинку); 
		Картинка = ПолучитьНавигационнуюСсылку(Объект.Ссылка,"ДанныеСообщения"); 		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "ПриСозданииНаСервере".
//
// Отображает сохранённое изображение; для нового сообщения
// заполняет пользователя текущим пользователем и наименование.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - стандартная обработка события.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Картинка = ПолучитьНавигационнуюСсылку(Объект.Ссылка,"ДанныеСообщения"); 
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Пользователь = Константы.ТекущийПользователь.Получить();
		Наименование = Строка(Объект.Пользователь) + ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры



