
// Обработчик события "ПередЗаписью".
//
// Для новых сообщений чата автоматически заполняет наименование
// (имя пользователя + дата) и период текущей датой.
//
// Параметры:
//  Отказ - Булево - признак отказа от записи.
Процедура ПередЗаписью(Отказ)
	
	Если ЭтоНовый() Тогда
		Наименование = Строка(Пользователь) + ТекущаяДата();
		Период = ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры
