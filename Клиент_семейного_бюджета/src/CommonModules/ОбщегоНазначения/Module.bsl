
// Обработчик события "ПриНачалеРаботыСистемы".
//
// При первом подключении к базе выполняет первоначальную настройку:
//  - загружает данные с Яндекс.Диска;
//  - получает и устанавливает код узла плана обмена.
// После чего запускает фоновое задание синхронизации данных.
Процедура ПриНачалеработыСистемы() Экспорт
	
	ЭтоНепервоеПодключение = Ложь;
	Если Не Константы.ЭтоНеПервоеПодключение.Получить() Тогда
		Получениеданных.ВыполнитьЗагрузкуСЯндэксДиска();
		ПолучитьИУстановитьКодУзла();
		ЭтоНепервоеПодключение = Истина;
	КонецЕсли;	
	ФоновыеЗадания.Выполнить("Получениеданных.ВыполнитьСинхронизацию");
	Если ЭтоНепервоеПодключение Тогда
		ЖдатьДо = ТекущаяДата() + 2;
		Пока ТекущаяДата() < ЖдатьДо Цикл
		КонецЦикла;
	КонецЕсли;
	//1
КонецПроцедуры

// Получает код узла с сервера обмена через веб-сервис "ОбмеДанными"
// и устанавливает его для текущего узла плана обмена "Мобильный".
// При возникновении ошибки выводит её описание в окно сообщений.
Процедура ПолучитьИУстановитьКодУзла()
	
	Попытка
		ВСОпределение = Новый WSОпределения(Константы.АдресПодключения.Получить(),
		Константы.Логин.Получить(),
		Константы.Пароль.Получить(),,,);
		ВССервис = ВсОпределение.Сервисы.Получить("DataTransfer","ОбмеДанными");
		ВСТочкаВхода = ВССервис.ТочкиПодключения.Получить("ОбмеДаннымиSoap");
		ВСОперация = ВСТочкаВхода.Интерфейс.Операции.Получить("Синхронизация");  		
		Данные = Новый ХранилищеЗначения("ЭтоПервоеПодключение",Новый СжатиеДанных(9));
		ДанныеXDTO = ВСОпределение.ФабрикаXDTO.Создать(ВСОперация.Параметры.Получить("Данные").Тип,Данные);
		ВСПрокси = Новый WSПрокси(ВСОпределение,"DataTransfer","ОбмеДанными","ОбмеДаннымиSoap",); 
		ВСПрокси.Пользователь = Константы.Логин.Получить();
		ВСПрокси.Пароль = Константы.Пароль.Получить();
		Ответ = ВСПрокси.Синхронизация(ДанныеXDTO); 
		ПринятьИзмененияКода(Ответ.Получить());		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры

// Принимает код, полученный с сервера обмена, и выполняет
// первоначальную настройку плана обмена "Мобильный":
//  - устанавливает код текущему узлу;
//  - создает узел "ЦБ" (центральная база);
//  - устанавливает константу "ЭтоНеПервоеПодключение".
//
// Параметры:
//  Код - Строка - код узла, полученный с сервера обмена.
Процедура ПринятьИзмененияКода(Код)
	
	ЭтотУзелСсылка = ПланыОбмена.Мобильный.ЭтотУзел(); 
	ЭтотУзел = ЭтотУзелСсылка.ПолучитьОбъект();
	ЭтотУзел.Код = Строка(Код); 	
	ЭтотУзел.Наименование = Строка(Код);
	ЭтотУзел.Записать();
	НУзел = ПланыОбмена.Мобильный.СоздатьУзел();
	НУзел.Код = "ЦБ";
	НУзел.Наименование = "ЦБ";
	НУзел.Записать();
	Константы.ЭтонеПервоеПодключение.Установить(Истина);
	
КонецПроцедуры

// Определяет старшую из трех версий программ.
//
// Версия - строка из четырех целых чисел, разделенных точками.
// Числа целые, больше либо равны нулю, могут начинаться с нулей.
// Примеры: "8.1.13.41", "8.1.009.125", "8.01.09.124".
//
// Параметры:
//  Версия1 - Строка - первая версия;
//  Версия2 - Строка - вторая версия;
//  Версия3 - Строка - третья версия.
//
// Возвращаемое значение:
//  Строка - старшая из переданных версий.
Функция СтаршаяВерсия(Версия1, Версия2, Версия3) Экспорт
	
	Старшая = Версия1;
	
	Если СравнитьВерсии(Версия2, Старшая) > 0 Тогда
		Старшая = Версия2;
	КонецЕсли;
	
	Если СравнитьВерсии(Версия3, Старшая) > 0 Тогда
		Старшая = Версия3;
	КонецЕсли;
	
	Возврат Старшая;
	
КонецФункции

// Сравнивает две версии программ.
//
// Параметры:
//  Версия1 - Строка - первая версия;
//  Версия2 - Строка - вторая версия.
//
// Возвращаемое значение:
//  Число - -1, если Версия1 младше Версия2;
//          0, если версии равны;
//          1, если Версия1 старше Версия2.
Функция СравнитьВерсии(Версия1, Версия2)
	
	Части1 = СтрРазделить(Версия1, ".");
	Части2 = СтрРазделить(Версия2, ".");
	
	Для Номер = 1 По 4 Цикл
		
		Если Номер <= Части1.Количество() Тогда
			Число1 = Число(СокрЛП(Части1[Номер - 1]));
		Иначе
			Число1 = 0;
		КонецЕсли;
		
		Если Номер <= Части2.Количество() Тогда
			Число2 = Число(СокрЛП(Части2[Номер - 1]));
		Иначе
			Число2 = 0;
		КонецЕсли;
		
		Если Число1 > Число2 Тогда
			Возврат 1;
		ИначеЕсли Число1 < Число2 Тогда
			Возврат -1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

// Сортирует переданный массив по возрастанию или убыванию
// методом "сортировка пузырьком" (на месте, без создания копии).
//
// Сравнение элементов выполняется стандартным для платформы способом,
// поэтому массив может содержать любые сравнимые между собой значения
// (числа, строки, даты и т.п.).
//
// Параметры:
//  Массив - Массив - сортируемый массив, изменяется на месте;
//  Направление - Строка - "Возр" (по возрастанию, по умолчанию)
//                         или "Убыв" (по убыванию).
Процедура СортироватьМассив(Массив, Направление = "Возр") Экспорт
	
	Убывание = ВРег(СокрЛП(Направление)) = "УБЫВ";
	ВерхняяГраница = Массив.ВГраница();
	
	Для Номер = 0 По ВерхняяГраница - 1 Цикл
		
		Для НомерВнутр = 0 По ВерхняяГраница - 1 - Номер Цикл
			
			Значение1 = Массив[НомерВнутр];
			Значение2 = Массив[НомерВнутр + 1];
			
			Если (Значение1 > Значение2 И Не Убывание)
				ИЛИ (Значение1 < Значение2 И Убывание) Тогда
				
				Массив[НомерВнутр]     = Значение2;
				Массив[НомерВнутр + 1] = Значение1;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает новый массив, отсортированный по возрастанию или убыванию.
// Исходный массив при этом не изменяется.
//
// Параметры:
//  Массив - Массив - исходный массив;
//  Направление - Строка - "Возр" (по возрастанию, по умолчанию)
//                         или "Убыв" (по убыванию).
//
// Возвращаемое значение:
//  Массив - новый отсортированный массив.
Функция ОтсортированныйМассив(Массив, Направление = "Возр") Экспорт
	
	Результат = Новый Массив(Массив.Количество());
	Для Номер = 0 По Массив.ВГраница() Цикл
		Результат[Номер] = Массив[Номер];
	КонецЦикла;
	
	СортироватьМассив(Результат, Направление);
	
	Возврат Результат;
	
КонецФункции
